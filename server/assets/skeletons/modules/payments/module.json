{
  "name": "payments",
  "label": "Checkout rails: Stripe, PayPal, Ziina, Telr, N-Genius, Binance Pay (keys pasted in-app)",
  "deps": [
    "catalog"
  ],
  "mounts": [
    {
      "path": "/api/payments",
      "router": "./routes/payments.js",
      "auth": false
    },
    {
      "path": "/api/payments-admin",
      "router": "./routes/paymentsAdmin.js",
      "auth": true
    }
  ],
  "nav": [
    {
      "key": "payments",
      "label": "Payments",
      "icon": "tag",
      "page": "./pages/Payments.jsx"
    }
  ],
  "verify": {
    "routes": [
      {
        "method": "GET",
        "path": "/api/payments-admin/settings",
        "auth": true,
        "expect": 200
      },
      {
        "method": "POST",
        "path": "/api/payments/checkout",
        "expect": 400
      }
    ]
  }
}