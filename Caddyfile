# SITE_ADDRESS + CADDY_TLS come from .env (see docker-compose.tls.yml).
#
#  IP / no domain (default):
#    SITE_ADDRESS=:443   CADDY_TLS=internal
#    -> Caddy serves HTTPS with its own self-signed cert (browser warns once).
#
#  Real domain (A record -> this server):
#    SITE_ADDRESS=arksai.example.com   CADDY_TLS=you@example.com
#    -> automatic Let's Encrypt cert, no warning. (CADDY_TLS = your email.)
{$SITE_ADDRESS::443} {
	encode zstd gzip
	tls {$CADDY_TLS:internal}
	# SSE streams pass through fine; Caddy flushes the proxy.
	reverse_proxy arksai:3000
}
