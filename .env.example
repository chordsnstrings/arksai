# --- Required ---

# MiniMax API key — the LLM engine (and image/vision/speech/video). Must be a
# Subscription Key (sk-cp-…) to draw on the Token Plan. The app refuses to start
# in production without it. NEVER commit the real key; rotate any key pasted in chat.
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M3              # 'ArksAI Max' / Auto default (multimodal → also vision)
# MINIMAX_FALLBACK_MODEL=MiniMax-M2.7-highspeed   # 'ArksAI Flash' (fast/cheap tier)
# MINIMAX_GROUP_ID=                     # required by some endpoints (T2A voice, etc.)

# Password required to log in to the web UI. The app refuses to start in
# production without it (this app can execute shell commands!).
APP_PASSWORD=

# --- GitHub integration ---

# Fine-grained Personal Access Token used to clone and push repositories.
# Recommended scope: contents read/write on the specific repos only.
GITHUB_TOKEN=

# --- Web research (optional) ---
# The agent always has web_search + web_fetch. Without a key it uses a
# DuckDuckGo fallback; set one of these for higher-quality results.
# SERPER_API_KEY=     # https://serper.dev (Google results)
# BRAVE_API_KEY=      # https://brave.com/search/api

# --- Engines (orchestration spine) ---
# Music generation via Suno (sunoapi.org / apibox). When set, the agent gets a
# generate_music tool. Cost per track is added to the session cost bar.
# SUNO_API_KEY=
# SUNO_BASE_URL=https://api.sunoapi.org
# SUNO_COST_PER_TRACK=0.08

# (MiniMax is configured in the Required section above — it's the LLM engine.)

# --- Optional ---

# HTTP port (default 3000)
PORT=3000

# Where session workspaces live, and the SQLite DB when DATABASE_URL is unset
# (default ./data, /data in Docker)
# DATA_DIR=/data

# Managed PostgreSQL for durable storage (sessions, history, custom commands).
# When set, the app uses Postgres instead of local SQLite, so data survives even
# if the Droplet/volume is destroyed. Use the DO managed-DB connection string
# (includes ?sslmode=require). Leave unset to use SQLite on the volume.
# DATABASE_URL=postgresql://doadmin:PASSWORD@HOST:25060/defaultdb?sslmode=require

# Max agent runs executing at once across all sessions (default 3)
# MAX_CONCURRENT_RUNS=3

# Safety ceiling on model/tool steps per run. The agent normally stops on its
# own when the task is done or it needs your input; this only caps runaway
# loops. Raise for very long autonomous tasks (default 200).
# MAX_ITERATIONS=200

# Delete session workspaces older than this many days on boot (default 14)
# WORKSPACE_TTL_DAYS=14

# Set to "true" when serving behind HTTPS so the auth cookie is Secure
# COOKIE_SECURE=false

# --- TLS (docker-compose.tls.yml + Caddy) ---
# IP / no domain (default): leave both unset -> self-signed cert (browser warns).
# Real domain: set SITE_ADDRESS to the domain (A record -> this server) and
# CADDY_TLS to your email, for an automatic Let's Encrypt cert.
# SITE_ADDRESS=arksai.example.com
# CADDY_TLS=you@example.com

# --- Open-ended / unrestricted agent (DANGER) ---
# When true, the agent's shell inherits the FULL environment (so it can use the
# credentials below), the workspace path jail is lifted, and file tools may
# touch anything on the host. Use only for trusted single-operator testing.
# Set back to false (or remove) to re-harden.
AGENT_UNRESTRICTED=true

# Credentials exposed to the agent when AGENT_UNRESTRICTED=true.
# doctl is preinstalled; the agent can `doctl auth init -t $DIGITALOCEAN_TOKEN`
# or call the DO API directly with curl.
# DIGITALOCEAN_TOKEN=
# Add any other tokens the agent should be able to use, e.g.:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
