# --- Required ---

# ModelArk API key (BytePlus) — the platform's SINGLE model provider: every chat/build
# lane, vision, image generation, video and embeddings run on it. Without it no model
# feature works. Optional here: the operator can instead set it with no SSH under
# Admin → Keys (stored encrypted in the DB; an admin-set key wins over this env value until
# you press "Use server key instead" there). NEVER commit the real key; rotate any key pasted in chat.
ARK_API_KEY=
# BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/coding/v3        # coding plan: chat lanes + embeddings
# BYTEPLUS_VIDEO_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3         # general: images, video, vision (Seed 2.1 Turbo isn't on the coding plan), voice-note transcription
# Branded lane → model overrides (defaults live in server/src/config.ts):
# ARK_MAX_MODEL=deepseek-v4-pro-ga-260813      # 'ArksAI Max' / Auto default
# ARK_FLASH_MODEL=deepseek-v4-pro-ga-260813    # 'ArksAI Flash' (thinking off)
# ARK_SWIFT_MODEL=deepseek-v4-pro-ga-260813    # 'ArksAI Swift' (thinking off)
# ARK_HEAVY_MODEL=deepseek-v4-pro-ga-260813    # every code build (full reasoning)
# ARK_SHEET_MODEL=deepseek-v4-pro-ga-260813    # spreadsheet / financial-model briefs (reasoning_effort low)
# ARK_GLM_MODEL=glm-5-2-260617                 # alternate engine (stall ladder)
# ARK_SEED_MODEL=seed-2-0-pro-260328           # alternate engine (stall ladder)
# Capability models:
# ARK_VISION_MODEL=dola-seed-2-1-turbo-260628  # see_image + every visual QC gate
# ARK_VISION_ENDPOINT=general                  # 'general' (default) or 'coding'
# ARK_TEXT_MODEL=deepseek-v4-pro-ga-260813     # one-shot utility text (briefs, digests, planning)
# ARK_CODER_MODEL=deepseek-v4-pro-ga-260813    # SVG / code authoring (logos)
# ARK_IMAGE_MODEL=dola-seedream-5-0-pro-260628 # image generation
# ARK_EMBED_MODEL=skylark-embedding-vision-251215  # screenshot / video-frame similarity
# ARK_REPLY_ALT_MODEL=glm-5-2-260617           # robot replies: the 'Compare both' second lane (vs ArksAI Max)
# ROBOT_ASR_MODEL=seed-2-0-mini-260428         # robot voice-note transcription (general endpoint)
# Concurrency caps (excess calls queue instead of hitting 429s):
# ARK_MAX_CONCURRENCY=6                        # concurrent agent-loop streams
# ARK_VISION_CONCURRENCY=4                     # concurrent vision calls (design gates, page reviews)
# ARK_TEXT_CONCURRENCY=4                       # concurrent one-shot text calls (briefs, replies, digests)
# ARK_EMBED_CONCURRENCY=4                      # concurrent similarity-embedding calls
# Per-call cost estimates for the session cost bar (USD; real usage wins when returned):
# ARK_VISION_COST=0.003
# ARK_TEXT_COST=0.004
# ARK_IMAGE_COST=0.045
# ARK_EMBED_COST=0.0005
# ARK_CODE_REVIEW_COST=0.006
# Timeouts / output budget:
# ARK_MAX_TOKENS=40000          # agent-loop max_tokens per turn
# ARK_IDLE_MS=180000            # stream content-idle → stall ladder
# ARK_TEXT_TIMEOUT_MS=150000
# ARK_VISION_TIMEOUT_MS=60000
# ARK_IMAGE_TIMEOUT_MS=150000
# Video (Seedance) cost estimates:
# SEEDANCE_DRAFT_COST=0.05
# SEEDANCE_FINAL_COST_PER_SEC=0.08
# SEEDANCE_COST_PER_KTOK=0.0018

# Password required to log in to the web UI. The app refuses to start in
# production without it (this app can execute shell commands!).
APP_PASSWORD=

# --- GitHub integration ---

# Fine-grained Personal Access Token used to clone and push repositories.
# Recommended scope: contents read/write on the specific repos only.
GITHUB_TOKEN=

# --- Web research (optional) ---
# The agent always has web_search + web_fetch. Without a key it uses a
# DuckDuckGo fallback; set one of these for higher-quality results.
# SERPER_API_KEY=     # https://serper.dev (Google results)
# BRAVE_API_KEY=      # https://brave.com/search/api

# --- Engines (orchestration spine) ---
# Music generation via Suno (sunoapi.org / apibox). When set, the agent gets a
# generate_music tool. Cost per track is added to the session cost bar.
# SUNO_API_KEY=
# SUNO_BASE_URL=https://api.sunoapi.org
# SUNO_COST_PER_TRACK=0.08

# (ModelArk is configured in the Required section above — it's the model provider.)

# --- Ad-platform connectors (Meta / Google Ads / TikTok) — see CONNECTORS.md ---
# Per-org OAuth links so the agent can fetch LIVE ad performance (fetch_ads). Each
# provider lights up only when its creds + the encryption key are set. NEVER commit.
# CONNECTOR_ENC_KEY=        # REQUIRED for connectors — encrypts OAuth tokens at rest
# PUBLIC_BASE_URL=https://arksai.studio   # builds the OAuth redirect URIs (must be HTTPS)
# META_APP_ID=
# META_APP_SECRET=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# --- Optional ---

# HTTP port (default 3000)
PORT=3000

# Where session workspaces live, and the SQLite DB when DATABASE_URL is unset
# (default ./data, /data in Docker)
# DATA_DIR=/data

# Managed PostgreSQL for durable storage (sessions, history, custom commands).
# When set, the app uses Postgres instead of local SQLite, so data survives even
# if the Droplet/volume is destroyed. Use the DO managed-DB connection string
# (includes ?sslmode=require). Leave unset to use SQLite on the volume.
# DATABASE_URL=postgresql://doadmin:PASSWORD@HOST:25060/defaultdb?sslmode=require

# Max agent runs executing at once across all sessions (default 3)
# MAX_CONCURRENT_RUNS=3

# Safety ceiling on model/tool steps per run. The agent normally stops on its
# own when the task is done or it needs your input; this only caps runaway
# loops. Raise for very long autonomous tasks (default 200).
# MAX_ITERATIONS=200

# Delete session workspaces older than this many days on boot (default 14)
# WORKSPACE_TTL_DAYS=14

# Set to "true" when serving behind HTTPS so the auth cookie is Secure
# COOKIE_SECURE=false

# --- TLS (docker-compose.tls.yml + Caddy) ---
# IP / no domain (default): leave both unset -> self-signed cert (browser warns).
# Real domain: set SITE_ADDRESS to the domain (A record -> this server) and
# CADDY_TLS to your email, for an automatic Let's Encrypt cert.
# SITE_ADDRESS=arksai.example.com
# CADDY_TLS=you@example.com
#
# Clean per-app subdomains: the server already routes <slug>.apps.<domain> and Caddy mints
# on-demand TLS (see the *.apps block in the Caddyfile). To make published apps advertise the
# clean URL https://<slug>.apps.arksai.studio/ instead of the path /apps/<slug>/, FIRST add a
# wildcard DNS A record  *.apps.arksai.studio -> <this droplet's IP>  and confirm it resolves,
# THEN set this (else apps keep using the always-working path URL):
# APPS_SUBDOMAIN_BASE=apps.arksai.studio

# --- Open-ended / unrestricted agent (DANGER) ---
# When true, the agent's shell inherits the FULL environment (so it can use the
# credentials below), the workspace path jail is lifted, and file tools may
# touch anything on the host. Use only for trusted single-operator testing.
# Set back to false (or remove) to re-harden.
AGENT_UNRESTRICTED=true

# Credentials exposed to the agent when AGENT_UNRESTRICTED=true.
# doctl is preinstalled; the agent can `doctl auth init -t $DIGITALOCEAN_TOKEN`
# or call the DO API directly with curl.
# DIGITALOCEAN_TOKEN=
# Add any other tokens the agent should be able to use, e.g.:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
